---
import { listSubjects } from "../lib/db";
import "../styles.css";

const subjects = listSubjects();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Draft timetable · MyTimetable, redesigned</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My draft timetable</h1>
      <p>The class catalogue is seeded; the timetable itself comes next.</p>
      <ul>
        {subjects.map((s) => <li>{s.code} {s.name}</li>)}
      </ul>
    </main>
  </body>
</html>
